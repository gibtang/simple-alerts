{
  "name": "simple-alerts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "workspaces": [
    "packages/nextjs"
  ],
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "npm run build:sdk && next build --webpack",
    "build:sdk": "npm --workspace @simple-alerts/nextjs run build",
    "start": "next start --hostname 0.0.0.0",
    "worker": "tsx src/server/worker.ts",
    "password": "node scripts/password.mjs",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test --test-concurrency=2 src/server/*.test.ts packages/nextjs/test/*.test.ts"
  },
  "dependencies": {
    "dotenv": "^17.2.3",
    "next": "^16.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "yaml": "^2.8.1",
    "zod": "^4.1.12",
    "tsx": "^4.20.6"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "typescript": "^5.9.3"
  }
}
