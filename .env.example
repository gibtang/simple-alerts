# Copy to .env. Never commit populated values.
ALERTS_CONFIG=./alerts.yaml
ALERTS_BASE_URL=http://localhost:3000
ALERTS_DATABASE_PATH=./data/alerts.sqlite
# Generate each secret independently: openssl rand -hex 32
ALERTS_SESSION_SECRET=
MY_APP_REPORTING_KEY=
# Generate with npm run password; quote the entire scrypt hash.
ALERTS_PASSWORD_HASH=''
TELEGRAM_BOT_TOKEN=
MY_APP_TELEGRAM_CHAT_ID=
